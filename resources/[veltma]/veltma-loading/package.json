{
  "name": "veltma-loading",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable Veltma loading screen for FiveM",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
